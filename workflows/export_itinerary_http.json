        "jsonBody": "={{ JSON.stringify({ itinerary: ($json.body ?? $json).itinerary, export_format: ($json.body ?? $json).export_format || 'pdf', trip_title: ($json.body ?? $json).trip_title, rag_citations: ($json.body ?? $json).rag_citations || [] }) }}",
