      "id": "b1b2c3d4-http-render-email",
      "name": "Render via API (email)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 220],
      "notesInFlow": true,
      "notes": "Email path: render PDF before Gmail delivery."
    },
    {
      "parameters": {
        "jsCode": "const webhook = $('Export Itinerary Webhook').first().json;\nconst body = webhook.body ?? webhook;\nconst render = $input.first().json;\nconst b64 = render.content_base64;\nif (!b64) {\n  throw new Error('Render response missing content_base64');\n}\nconst recipient = body.recipient_email;\nif (!recipient) {\n  throw new Error('recipient_email is required for email delivery');\n}\nconst filename = render.filename || 'itinerary.pdf';\nconst buffer = Buffer.from(b64, 'base64');\nreturn [{\n  json: {\n    recipient_email: recipient,\n    trip_title: render.trip_title || body.trip_title || 'Your trip itinerary',\n    filename,\n  },\n  binary: {\n    attachment: await this.helpers.prepareBinaryData(buffer, filename, render.media_type || 'application/pdf'),\n  },\n}];"
      },
      "id": "b1b2c3d4-prepare-email",
      "name": "Prepare PDF attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 220]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.recipient_email }}",
        "subject": "={{ $json.trip_title || 'Your trip itinerary' }}",
        "emailType": "html",
        "message": "<p>Your itinerary is attached as a PDF.</p>",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "attachment"
              }
            ]
          }
        }
      },
      "id": "b1b2c3d4-gmail-send",
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1280, 220],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_IN_N8N",
          "name": "Gmail account"
        }
      },
      "notesInFlow": true,
      "notes": "Connect your Gmail OAuth credential in n8n Cloud. No recipient is hardcoded."
    },
